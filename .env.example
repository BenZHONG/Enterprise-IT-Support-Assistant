# Copy this file to .env and fill in your own values. Never commit .env.
# Leave OPENAI_API_KEY empty to run in rules-only mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=2

# Demo sign-in tokens for the fictional employees (Stage 5).
# Generate real values with:  python -m scripts.make_demo_tokens
# Then replace the blank lines below. Blank entries are ignored.
# These are FAKE demo credentials. A real deployment uses an identity provider.
DEMO_TOKEN_E1001=
DEMO_TOKEN_E1002=
DEMO_TOKEN_E1003=
DEMO_TOKEN_E1004=
DEMO_TOKEN_E1005=
DEMO_TOKEN_E1006=
DEMO_TOKEN_E1007=
DEMO_TOKEN_E1008=

# Mock ITSM service (Stage 6). Leave ITSM_DB_PATH blank for data/itsm.sqlite3.
# The assistant uses the READ token to read. The WRITE token is used from
# Stage 15 and is deliberately a different secret.
ITSM_DB_PATH=
ITSM_READ_TOKEN=
ITSM_WRITE_TOKEN=